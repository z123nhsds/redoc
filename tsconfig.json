{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es5",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "declaration": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "outDir": "lib",
    "pretty": true,
    "lib": ["es2015", "es2016", "es2017", "dom", "WebWorker.ImportScripts"],
    "jsx": "react",
    "types": ["node", "webpack", "webpack-env", "jest"]
  },
  "compileOnSave": false,
  "include": [
    "./custom.d.ts",
    "./demo/*.ts",
    "./demo/*.tsx",
    "./demo/playground/*.ts",
    "./demo/playground/*.tsx",
    "./benchmark/**/*.ts",
    "./benchmark/**/*.tsx",
    "./src/**/*.ts",
    "./src/**/*.tsx",
    "./cypress.config.mts",
    "src/empty.js"
  ]
}
